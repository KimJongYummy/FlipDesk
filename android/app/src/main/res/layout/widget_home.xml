<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFF2F2F2" android:textSize="14sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" android:text="@string/app_name" />
        <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FF9A9A9A" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/w_vol_down" style="@style/WidgetButton" android:src="@drawable/ic_volume_down"
        android:contentDescription="@string/volume_down" />
    <ImageButton android:id="@+id/w_play" style="@style/WidgetButtonAccent" android:src="@drawable/ic_play"
        android:contentDescription="@string/play_pause" />
    <ImageButton android:id="@+id/w_vol_up" style="@style/WidgetButton" android:src="@drawable/ic_volume_up"
        android:contentDescription="@string/volume_up" />
    <ImageButton android:id="@+id/w_lock" style="@style/WidgetButton" android:src="@drawable/ic_lock"
        android:contentDescription="@string/lock_pc" />
</LinearLayout>
