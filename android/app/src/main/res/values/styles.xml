<resources>
    <style name="Theme.FlipDesk" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="Theme.FlipDesk.Translucent" parent="Theme.FlipDesk">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="WidgetButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">@drawable/widget_btn</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">#FFF2F2F2</item>
    </style>
    <style name="WidgetButtonAccent" parent="WidgetButton">
        <item name="android:background">@drawable/widget_btn_accent</item>
        <item name="android:tint">#FF000000</item>
    </style>
    <style name="WidgetButtonBig" parent="WidgetButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
    </style>
    <style name="WidgetButtonBigAccent" parent="WidgetButtonBig">
        <item name="android:background">@drawable/widget_btn_accent</item>
        <item name="android:tint">#FF000000</item>
    </style>
</resources>
